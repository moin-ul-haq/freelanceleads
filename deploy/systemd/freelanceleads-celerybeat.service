[Unit]
Description=FreelanceLeads Celery beat
After=network.target redis-server.service

[Service]
WorkingDirectory=/root/freelanceleads
Environment=C_FORCE_ROOT=true
ExecStart=/root/freelanceleads/venv/bin/celery -A freelanceleads beat \
  -l info --schedule /root/freelanceleads/celerybeat-schedule
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
